  <compiler angle="radian" autolimits="true"/>
  <size njmax="500" nconmax="100"/>
  <visual>
      <map fogstart="1.5" fogend="4" force="0.1"/>
      <quality shadowsize="4096"/>
  </visual>

  <asset>
    <mesh file="../../ur_sim/ur10e/meshes/base_0.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/base_1.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/shoulder_0.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/shoulder_1.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/shoulder_2.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/upperarm_0.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/upperarm_1.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/upperarm_2.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/upperarm_3.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/forearm_0.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/forearm_1.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/forearm_2.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/forearm_3.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist1_0.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist1_1.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist1_2.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist2_0.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist2_1.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist2_2.obj"/>
    <mesh file="../../ur_sim/ur10e/meshes/wrist3.obj"/>

    <material class="ur10e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur10e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur10e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur10e" name="urblue" rgba="0.49 0.678 0.8 1"/>
    <material class="ur10e" name="ur10e_MatColl" specular="1" shininess=".3" reflectance="0.5" rgba=".4 .5 .6 1"/>

  </asset>


  <default>
    <default class="ur10e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <position ctrlrange="-6.2831 6.2831"/>
      <general biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="5000" biasprm="0 -5000 -500"/>

      <default class="size4">
        <joint damping="10"/>
        <general forcerange="-330 330"/>
      </default>

      <default class="size3">
        <joint damping="5"/>
        <general forcerange="-150 150"/>
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>

      <default class="size2">
        <joint damping="2"/>
        <general forcerange="-56 56"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1"/>
      </default>

      <default class="collision">
        <geom type="capsule" group="4" material="ur10e_MatColl"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>

      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <actuator>
    <general class="size4" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="size4" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size3_limited" name="elbow" joint="elbow_joint"/>
    <general class="size2" name="wrist_1" joint="wrist_1_joint"/>
    <general class="size2" name="wrist_2" joint="wrist_2_joint"/>
    <general class="size2" name="wrist_3" joint="wrist_3_joint"/>
  </actuator>

  <sensor>
    <jointpos joint="shoulder_pan_joint"     name="shoulder_pan_pos"/>
    <jointpos joint="shoulder_lift_joint"    name="shoulder_lift_pos"/>
    <jointpos joint="elbow_joint"            name="elbow_pos"/>
    <jointpos joint="wrist_1_joint"          name="wrist_1_pos"/>
    <jointpos joint="wrist_2_joint"          name="wrist_2_pos"/>
    <jointpos joint="wrist_3_joint"          name="wrist_3_pos"/>
  </sensor>

</mujocoinclude>